# 🦁 Singh Ji Agentic AI v10.0 — Environment Variables
# Copy this to .env and fill in your values

# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_chat_id

# AI APIs
GROQ_API_KEY=your_groq_api_key

# Database (Optional — falls back to local JSON)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Instagram (Optional — for auto-post)
INSTAGRAM_ACCESS_TOKEN=your_ig_token
INSTAGRAM_USER_ID=your_ig_user_id

# WhatsApp (Optional)
ULTRAMSG_TOKEN=your_ultramsg_token
ULTRAMSG_INSTANCE=your_instance_id

# Email (Optional)
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=singhji@digital.com

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Netlify (Optional)
NETLIFY_TOKEN=your_netlify_token

# Render Self URL (Auto-set by Render)
RENDER_EXTERNAL_URL=https://your-app.onrender.com
