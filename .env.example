# 🦁 Singh Ji Agentic AI v10.0 — Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED — These MUST be set
# ============================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (get from @userinfobot)
ADMIN_CHAT_ID=your_chat_id_here

# Groq API Key (free tier — groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# WEB SEARCH APIs (Choose at least one)
# ============================================

# Serper.dev — 2,500 free trial queries (BEST for Google Search)
# Get key: https://serper.dev
SERPER_API_KEY=your_serper_key_here

# Tavily — 1,000 free credits/month (BEST for AI/RAG)
# Get key: https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Scrapfly — 1,000 free credits (SERP + any page)
# Get key: https://scrapfly.io
SCRAPFLY_API_KEY=your_scrapfly_key_here

# ============================================
# GOOGLE MAPS API (For Real Business Search)
# ============================================

# Google Cloud Console → APIs & Services → Credentials → API Key
# Enable: Places API, Geocoding API
# Free tier: $200 credit/month (~6,600 requests)
# Get key: https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ============================================
# WHATSAPP APIs (Choose at least one)
# ============================================

# UltraMsg — $39/month (reliable, HTTP API)
# Get key: https://ultramsg.com
ULTRAMSG_TOKEN=your_ultramsg_token
ULTRAMSG_INSTANCE=your_instance_id

# CallMeBot — FREE for personal use (limited)
# Get key: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=your_callmebot_key

# ============================================
# EMAIL API
# ============================================

# SendGrid — Free: 100 emails/day
# Get key: https://sendgrid.com
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=singhji@digital.com

# ============================================
# NETLIFY DEPLOY
# ============================================

# Netlify Personal Access Token
# Get: https://app.netlify.com/user/applications/personal
NETLIFY_TOKEN=your_netlify_token

# ============================================
# INSTAGRAM (Optional)
# ============================================

# Instagram Graph API (Meta Developer)
# Requires: Business Account + App Review
INSTAGRAM_ACCESS_TOKEN=your_ig_token
INSTAGRAM_USER_ID=your_ig_user_id

# ============================================
# DATABASE (Optional — falls back to JSON)
# ============================================

# Supabase (free tier: 500MB)
# Get: https://supabase.com
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# ============================================
# DEPLOY
# ============================================

# Render/Railway auto-sets this
RENDER_EXTERNAL_URL=https://your-app.onrender.com
PORT=8000
